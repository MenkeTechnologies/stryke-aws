#!/usr/bin/env stryke
# examples/ddb_demo.stk — DynamoDB round-trip against a small test table.
#
# The table needs partition key `id` of type S. Create one with:
#   aws dynamodb create-table --table-name stryke-aws-demo \
#       --attribute-definitions AttributeName=id,AttributeType=S \
#       --key-schema AttributeName=id,KeyType=HASH \
#       --billing-mode PAY_PER_REQUEST

use AWS::Dynamo
use AWS::STS

val $alive = eval { AWS::STS::caller_identity() }
unless ($alive && defined $alive->{account}) {
    p "no usable AWS creds — set AWS_PROFILE or run in an instance role to exercise the demo"
    exit 0
}

val $table = $ARGV[0] // $ENV{STRYKE_AWS_TEST_TABLE} // ""
if ($table eq "") {
    p "creds reachable but no test table specified —"
    p "pass the table name as \$ARGV[0] or set \$STRYKE_AWS_TEST_TABLE."
    p "(create one with: aws dynamodb create-table --table-name stryke-aws-demo \\"
    p "  --attribute-definitions AttributeName=id,AttributeType=S \\"
    p "  --key-schema AttributeName=id,KeyType=HASH --billing-mode PAY_PER_REQUEST)"
    exit 0
}

AWS::Dynamo::put $table, {
    id    => "demo-1",
    name  => "alice",
    score => 1.5,
    tags  => ["a", "b", "c"],
    meta  => { color => "blue", n => 7 },
}

val $row = AWS::Dynamo::get $table, { id => "demo-1" }
p "got: " . to_json($row)

val @hits = AWS::Dynamo::query $table,
    expr => "id = :id",
    vals => { ":id" => "demo-1" }
p "query rows: " . len(@hits)

AWS::Dynamo::delete $table, { id => "demo-1" }
p "deleted"
