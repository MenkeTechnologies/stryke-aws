## t/test_stryke_aws_surface.stk — wrapper-completeness pin.
##
## Asserts every public `fn X::Y::name` declared in lib/*.stk is
## reachable via `use` at runtime. Uses `exists &X::Y::name` to
## probe the symbol table without invoking the sub.
##
## Catches:
##   * a wrapper sub deleted from lib/ but still referenced elsewhere
##   * a sub-package file dropped from the install layout
##   * `use Foo::Bar` failing to chase into lib/Bar.stk
##   * an installed-package entry whose namespace bridge is broken
##
## Permission-free — no service, no creds, no live daemon. Private
## helpers (`_` prefix) are implementation detail and are NOT
## asserted, so refactoring internals stays free.

use AWS
use AWS::Dynamo
use AWS::Lambda
use AWS::S3
use AWS::SQS
use AWS::STS
use AWS::SNS
use AWS::SSM
use AWS::Secrets
use AWS::SES
use AWS::CloudWatch

# ── AWS.stk ──────────────────────────────────────────────
assert_ok exists &AWS::version, "AWS::version exists"
assert_ok exists &AWS::ping, "AWS::ping exists"
assert_ok exists &AWS::sts_caller_identity, "AWS::sts_caller_identity exists"
assert_ok exists &AWS::s3_list_buckets, "AWS::s3_list_buckets exists"
assert_ok exists &AWS::s3_list_objects, "AWS::s3_list_objects exists"
assert_ok exists &AWS::s3_get_object, "AWS::s3_get_object exists"
assert_ok exists &AWS::s3_put_object, "AWS::s3_put_object exists"
assert_ok exists &AWS::s3_delete_object, "AWS::s3_delete_object exists"
assert_ok exists &AWS::s3_head_object, "AWS::s3_head_object exists"
assert_ok exists &AWS::ddb_list_tables, "AWS::ddb_list_tables exists"
assert_ok exists &AWS::ddb_put_item, "AWS::ddb_put_item exists"
assert_ok exists &AWS::ddb_get_item, "AWS::ddb_get_item exists"
assert_ok exists &AWS::ddb_delete_item, "AWS::ddb_delete_item exists"
assert_ok exists &AWS::ddb_query, "AWS::ddb_query exists"
assert_ok exists &AWS::ddb_scan, "AWS::ddb_scan exists"
assert_ok exists &AWS::ddb_describe_table, "AWS::ddb_describe_table exists"
assert_ok exists &AWS::sts_assume_role, "AWS::sts_assume_role exists"
assert_ok exists &AWS::sqs_list_queues, "AWS::sqs_list_queues exists"
assert_ok exists &AWS::sqs_send_message, "AWS::sqs_send_message exists"
assert_ok exists &AWS::sqs_receive_message, "AWS::sqs_receive_message exists"
assert_ok exists &AWS::sqs_delete_message, "AWS::sqs_delete_message exists"
assert_ok exists &AWS::sqs_purge_queue, "AWS::sqs_purge_queue exists"
assert_ok exists &AWS::sqs_get_queue_attributes, "AWS::sqs_get_queue_attributes exists"
assert_ok exists &AWS::lambda_invoke, "AWS::lambda_invoke exists"
assert_ok exists &AWS::lambda_list_functions, "AWS::lambda_list_functions exists"

# ── Dynamo.stk ──────────────────────────────────────────────
assert_ok exists &AWS::Dynamo::get, "AWS::Dynamo::get exists"
assert_ok exists &AWS::Dynamo::put, "AWS::Dynamo::put exists"
assert_ok exists &AWS::Dynamo::delete, "AWS::Dynamo::delete exists"
assert_ok exists &AWS::Dynamo::query, "AWS::Dynamo::query exists"
assert_ok exists &AWS::Dynamo::scan, "AWS::Dynamo::scan exists"
assert_ok exists &AWS::Dynamo::batch_write, "AWS::Dynamo::batch_write exists"
assert_ok exists &AWS::Dynamo::scan_stream, "AWS::Dynamo::scan_stream exists"
assert_ok exists &AWS::Dynamo::describe, "AWS::Dynamo::describe exists"
assert_ok exists &AWS::Dynamo::tables, "AWS::Dynamo::tables exists"

# ── Lambda.stk ──────────────────────────────────────────────
assert_ok exists &AWS::Lambda::invoke, "AWS::Lambda::invoke exists"
assert_ok exists &AWS::Lambda::call, "AWS::Lambda::call exists"
assert_ok exists &AWS::Lambda::list, "AWS::Lambda::list exists"

# ── S3.stk ──────────────────────────────────────────────
assert_ok exists &AWS::S3::ls, "AWS::S3::ls exists"
assert_ok exists &AWS::S3::get, "AWS::S3::get exists"
assert_ok exists &AWS::S3::put, "AWS::S3::put exists"
assert_ok exists &AWS::S3::head, "AWS::S3::head exists"
assert_ok exists &AWS::S3::rm, "AWS::S3::rm exists"
assert_ok exists &AWS::S3::presign, "AWS::S3::presign exists"
assert_ok exists &AWS::S3::buckets, "AWS::S3::buckets exists"

# ── SQS.stk ──────────────────────────────────────────────
assert_ok exists &AWS::SQS::send, "AWS::SQS::send exists"
assert_ok exists &AWS::SQS::receive, "AWS::SQS::receive exists"
assert_ok exists &AWS::SQS::delete, "AWS::SQS::delete exists"
assert_ok exists &AWS::SQS::purge, "AWS::SQS::purge exists"
assert_ok exists &AWS::SQS::attrs, "AWS::SQS::attrs exists"
assert_ok exists &AWS::SQS::list, "AWS::SQS::list exists"
assert_ok exists &AWS::SQS::pump, "AWS::SQS::pump exists"

# ── STS.stk ──────────────────────────────────────────────
assert_ok exists &AWS::STS::caller_identity, "AWS::STS::caller_identity exists"
assert_ok exists &AWS::STS::assume_role, "AWS::STS::assume_role exists"

# ── AWS.stk extras: S3 copy/batch, ddb update, SNS, SSM, Secrets ──
assert_ok exists &AWS::s3_copy_object, "AWS::s3_copy_object exists"
assert_ok exists &AWS::s3_delete_objects, "AWS::s3_delete_objects exists"
assert_ok exists &AWS::ddb_update_item, "AWS::ddb_update_item exists"
assert_ok exists &AWS::sns_list_topics, "AWS::sns_list_topics exists"
assert_ok exists &AWS::sns_publish, "AWS::sns_publish exists"
assert_ok exists &AWS::sns_create_topic, "AWS::sns_create_topic exists"
assert_ok exists &AWS::sns_subscribe, "AWS::sns_subscribe exists"
assert_ok exists &AWS::ssm_get_parameter, "AWS::ssm_get_parameter exists"
assert_ok exists &AWS::ssm_put_parameter, "AWS::ssm_put_parameter exists"
assert_ok exists &AWS::ssm_get_parameters_by_path, "AWS::ssm_get_parameters_by_path exists"
assert_ok exists &AWS::ssm_delete_parameter, "AWS::ssm_delete_parameter exists"
assert_ok exists &AWS::secrets_get_value, "AWS::secrets_get_value exists"
assert_ok exists &AWS::secrets_create, "AWS::secrets_create exists"
assert_ok exists &AWS::secrets_put_value, "AWS::secrets_put_value exists"
assert_ok exists &AWS::secrets_list, "AWS::secrets_list exists"

# ── SNS.stk ──────────────────────────────────────────────
assert_ok exists &AWS::SNS::topics, "AWS::SNS::topics exists"
assert_ok exists &AWS::SNS::create, "AWS::SNS::create exists"
assert_ok exists &AWS::SNS::publish, "AWS::SNS::publish exists"
assert_ok exists &AWS::SNS::subscribe, "AWS::SNS::subscribe exists"

# ── SSM.stk ──────────────────────────────────────────────
assert_ok exists &AWS::SSM::get, "AWS::SSM::get exists"
assert_ok exists &AWS::SSM::put, "AWS::SSM::put exists"
assert_ok exists &AWS::SSM::by_path, "AWS::SSM::by_path exists"
assert_ok exists &AWS::SSM::delete, "AWS::SSM::delete exists"

# ── Secrets.stk ──────────────────────────────────────────
assert_ok exists &AWS::Secrets::get, "AWS::Secrets::get exists"
assert_ok exists &AWS::Secrets::create, "AWS::Secrets::create exists"
assert_ok exists &AWS::Secrets::put, "AWS::Secrets::put exists"
assert_ok exists &AWS::Secrets::list, "AWS::Secrets::list exists"

assert_ok exists &AWS::ses_send_email, "AWS::ses_send_email exists"
assert_ok exists &AWS::cloudwatch_put_metric, "AWS::cloudwatch_put_metric exists"
assert_ok exists &AWS::cloudwatch_list_metrics, "AWS::cloudwatch_list_metrics exists"
assert_ok exists &AWS::SES::send, "AWS::SES::send exists"
assert_ok exists &AWS::CloudWatch::put, "AWS::CloudWatch::put exists"
assert_ok exists &AWS::CloudWatch::list, "AWS::CloudWatch::list exists"

assert_ok exists &AWS::ddb_batch_get_item, "AWS::ddb_batch_get_item exists"
assert_ok exists &AWS::ddb_batch_write_item, "AWS::ddb_batch_write_item exists"

# ── pure parse/build helpers ──
assert_ok exists &AWS::parse_arn, "AWS::parse_arn exists"
assert_ok exists &AWS::build_arn, "AWS::build_arn exists"
assert_ok exists &AWS::parse_s3_uri, "AWS::parse_s3_uri exists"
assert_ok exists &AWS::build_s3_uri, "AWS::build_s3_uri exists"
assert_ok exists &AWS::s3_uri_to_arn, "AWS::s3_uri_to_arn exists"
assert_ok exists &AWS::arn_to_s3_uri, "AWS::arn_to_s3_uri exists"
assert_ok exists &AWS::valid_bucket_name, "AWS::valid_bucket_name exists"
assert_ok exists &AWS::partition_for_region, "AWS::partition_for_region exists"
assert_ok exists &AWS::dns_suffix_for_partition, "AWS::dns_suffix_for_partition exists"
assert_ok exists &AWS::service_endpoint, "AWS::service_endpoint exists"
assert_ok exists &AWS::region_for_az, "AWS::region_for_az exists"

test_run
