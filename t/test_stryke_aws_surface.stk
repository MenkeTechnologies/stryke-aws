## t/test_stryke_aws_surface.stk — wrapper-completeness pin.
##
## Asserts every public `fn X::Y::name` declared in lib/*.stk is
## reachable via `use` at runtime. Uses `exists &X::Y::name` to
## probe the symbol table without invoking the sub.
##
## Catches:
##   * a wrapper sub deleted from lib/ but still referenced elsewhere
##   * a sub-package file dropped from the install layout
##   * `use Foo::Bar` failing to chase into lib/Bar.stk
##   * an installed-package entry whose namespace bridge is broken
##
## Permission-free — no service, no creds, no live daemon. Private
## helpers (`_` prefix) are implementation detail and are NOT
## asserted, so refactoring internals stays free.

use AWS
use AWS::Dynamo
use AWS::Lambda
use AWS::S3
use AWS::SQS
use AWS::STS
use AWS::SNS
use AWS::SSM
use AWS::Secrets
use AWS::SES
use AWS::CloudWatch
use AWS::EC2
use AWS::Logs
use AWS::KMS
use AWS::IAM
use AWS::Kinesis
use AWS::ECR
use AWS::StepFunctions

# ── AWS.stk ──────────────────────────────────────────────
assert_ok exists &AWS::version, "AWS::version exists"
assert_ok exists &AWS::ping, "AWS::ping exists"
assert_ok exists &AWS::sts_caller_identity, "AWS::sts_caller_identity exists"
assert_ok exists &AWS::s3_list_buckets, "AWS::s3_list_buckets exists"
assert_ok exists &AWS::s3_list_objects, "AWS::s3_list_objects exists"
assert_ok exists &AWS::s3_get_object, "AWS::s3_get_object exists"
assert_ok exists &AWS::s3_put_object, "AWS::s3_put_object exists"
assert_ok exists &AWS::s3_delete_object, "AWS::s3_delete_object exists"
assert_ok exists &AWS::s3_head_object, "AWS::s3_head_object exists"
assert_ok exists &AWS::ddb_list_tables, "AWS::ddb_list_tables exists"
assert_ok exists &AWS::ddb_put_item, "AWS::ddb_put_item exists"
assert_ok exists &AWS::ddb_get_item, "AWS::ddb_get_item exists"
assert_ok exists &AWS::ddb_delete_item, "AWS::ddb_delete_item exists"
assert_ok exists &AWS::ddb_query, "AWS::ddb_query exists"
assert_ok exists &AWS::ddb_scan, "AWS::ddb_scan exists"
assert_ok exists &AWS::ddb_describe_table, "AWS::ddb_describe_table exists"
assert_ok exists &AWS::sts_assume_role, "AWS::sts_assume_role exists"
assert_ok exists &AWS::sqs_list_queues, "AWS::sqs_list_queues exists"
assert_ok exists &AWS::sqs_send_message, "AWS::sqs_send_message exists"
assert_ok exists &AWS::sqs_receive_message, "AWS::sqs_receive_message exists"
assert_ok exists &AWS::sqs_delete_message, "AWS::sqs_delete_message exists"
assert_ok exists &AWS::sqs_purge_queue, "AWS::sqs_purge_queue exists"
assert_ok exists &AWS::sqs_get_queue_attributes, "AWS::sqs_get_queue_attributes exists"
assert_ok exists &AWS::lambda_invoke, "AWS::lambda_invoke exists"
assert_ok exists &AWS::lambda_list_functions, "AWS::lambda_list_functions exists"

