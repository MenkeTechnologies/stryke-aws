## t/test_aws.stk — assertion tests for the stryke `AWS` package.
##
## Uses stryke's native test framework (`assert_*` + `test_run`).
## Requires the cdylib to be loaded — install once with `s pkg install -g .`
## so stryke's FFI bridge dlopens `lib/libstryke_aws.{dylib,so}` on `use AWS`.
##
## Service-dependent assertions only fire when:
##   * AWS credentials reachable (STS::caller_identity succeeds), AND
##   * the relevant $STRYKE_AWS_TEST_BUCKET / _TABLE / _QUEUE env var is set.
## The permission-free assertions (version + cdylib loaded) always run, so
## CI without AWS access still exercises the FFI surface.

use AWS
use AWS::STS
use AWS::S3
use AWS::Dynamo
use AWS::SQS

# ── permission-free: cdylib reachable ───────────────────────────────
val $version = AWS::version()
assert_ok $version, "AWS::version returns truthy (cdylib loaded)"

# ── credentials probe ───────────────────────────────────────────────
val $id = eval { AWS::STS::caller_identity() }
val $have_creds = !$@ && defined $id && defined $id->{account}

if ($have_creds) {
    assert_ok defined $id->{account}, "caller_identity returns account"
    assert_ok defined $id->{arn}, "caller_identity returns arn"
    assert_ok AWS::ping(), "ping returns truthy when creds present"

    # ── S3 round-trip (only with $STRYKE_AWS_TEST_BUCKET) ───────
    val $bucket = $ENV{STRYKE_AWS_TEST_BUCKET}
    if (defined $bucket) {
        val $key = "stryke-aws-test/$$/" . time() . ".txt"
        val $uri = "s3://$bucket/$key"
        val $body = "hello-from-stryke-aws-$$"

        val $put = AWS::S3::put($uri, data => $body)
        assert_eq $put->{key}, $key, "s3 put returns the key we wrote"
        assert_eq AWS::S3::get($uri), $body, "s3 get round-trip"
        assert_eq AWS::S3::head($uri)->{size}, len($body), "s3 head size"
        val @ls = AWS::S3::ls("s3://$bucket/stryke-aws-test/$$/")
        assert_ge scalar(@ls), 1, "s3 ls finds at least our object"
        AWS::S3::rm($uri)
        assert_ok 1, "s3 rm completed without dying"
    }

    # ── Dynamo round-trip (only with $STRYKE_AWS_TEST_TABLE) ────
    val $table = $ENV{STRYKE_AWS_TEST_TABLE}
    if (defined $table) {
        val $pk = "stryke-aws-test-$$"
        val $put = AWS::Dynamo::put($table, { id => $pk, val => "alice", n => 42 })
        assert_ok $put->{ok}, "ddb put returns ok"
        val $got = AWS::Dynamo::get($table, { id => $pk })
        assert_eq $got->{val}, "alice", "ddb get round-trip val"
        assert_eq $got->{n}, 42, "ddb get round-trip n"
        val @q = AWS::Dynamo::query($table, expr => "id = :id", vals => { ":id" => $pk })
        assert_eq scalar(@q), 1, "ddb query returns 1 row"
        assert_eq $q[0]->{val}, "alice", "ddb query row val"
        AWS::Dynamo::delete($table, { id => $pk })
        assert_ok 1, "ddb delete completed without dying"
    }

    # ── SQS round-trip (only with $STRYKE_AWS_TEST_QUEUE) ───────
    val $queue = $ENV{STRYKE_AWS_TEST_QUEUE}
    if (defined $queue) {
        val $body = "msg-from-stryke-aws-$$-" . time()
        val $sent = AWS::SQS::send($queue, $body)
        assert_ok defined $sent->{message_id}, "sqs send returns message_id"
        val @msgs = AWS::SQS::receive($queue, max => 1, wait => 5)
        var $found_rh
        for val $m (@msgs) {
            if ($m->{body} eq $body) {
                $found_rh = $m->{receipt_handle}
                last
            }
        }
        assert_ok defined $found_rh, "sqs receive finds our body"
        if (defined $found_rh) {
            AWS::SQS::delete($queue, $found_rh)
            assert_ok 1, "sqs delete completed without dying"
        }
    }
}

# ── pure helpers (no AWS — always run) ───────────────────────────────
val $arn = AWS::parse_arn("arn:aws:iam::123456789012:role/Admin")
assert_eq $arn->{service},       "iam",          "parse_arn: service"
assert_eq $arn->{account_id},    "123456789012", "parse_arn: account"
assert_eq $arn->{resource_type}, "role",         "parse_arn: resource_type"
assert_eq $arn->{resource_id},   "Admin",        "parse_arn: resource_id"
assert_ok !defined($arn->{region}),              "parse_arn: empty region is undef"

val $lambda = AWS::parse_arn("arn:aws:lambda:us-east-1:123456789012:function:my-fn")
assert_eq $lambda->{resource_type}, "function", "parse_arn: colon resource form"
assert_eq $lambda->{resource_id},   "my-fn",    "parse_arn: colon resource id"

assert_eq AWS::build_arn(service => "s3", resource => "my-bucket"), "arn:aws:s3:::my-bucket", "build_arn: minimal"

val $s3 = AWS::parse_s3_uri("s3://my-bucket/path/to/obj.txt")
assert_eq $s3->{bucket}, "my-bucket",        "parse_s3_uri: bucket"
assert_eq $s3->{key},    "path/to/obj.txt",  "parse_s3_uri: key"
assert_ok !defined(AWS::parse_s3_uri("s3://only-bucket")->{key}), "parse_s3_uri: bucket-only key undef"

# build_s3_uri: inverse of parse_s3_uri; bare bucket when key omitted.
assert_eq AWS::build_s3_uri("my-bucket", "path/to/obj.txt"), "s3://my-bucket/path/to/obj.txt", "build_s3_uri: bucket+key"
assert_eq AWS::build_s3_uri("my-bucket"), "s3://my-bucket", "build_s3_uri: bare bucket when key omitted"
assert_eq AWS::build_s3_uri("my-bucket", "/leading"), "s3://my-bucket/leading", "build_s3_uri: trims leading slash on key"

# s3_uri_to_arn: s3:// URI → S3 ARN.
val $oarn = AWS::s3_uri_to_arn("s3://my-bucket/path/to/obj.txt")
assert_eq $oarn->{arn}, "arn:aws:s3:::my-bucket/path/to/obj.txt", "s3_uri_to_arn: object ARN"
assert_eq $oarn->{key}, "path/to/obj.txt",                        "s3_uri_to_arn: key extracted"
assert_eq AWS::s3_uri_to_arn("s3://my-bucket")->{arn}, "arn:aws:s3:::my-bucket", "s3_uri_to_arn: bucket ARN"
assert_eq AWS::s3_uri_to_arn("s3://b/k", "aws-cn")->{arn}, "arn:aws-cn:s3:::b/k", "s3_uri_to_arn: partition override"

# arn_to_s3_uri: S3 ARN → s3:// URI (inverse of s3_uri_to_arn).
val $u = AWS::arn_to_s3_uri("arn:aws:s3:::my-bucket/path/to/obj.txt")
assert_eq $u->{uri}, "s3://my-bucket/path/to/obj.txt", "arn_to_s3_uri: object URI"
assert_eq $u->{key}, "path/to/obj.txt",                "arn_to_s3_uri: key extracted"
assert_eq AWS::arn_to_s3_uri("arn:aws-cn:s3:::b")->{uri}, "s3://b", "arn_to_s3_uri: bare bucket, any partition"
assert_eq AWS::arn_to_s3_uri(AWS::s3_uri_to_arn("s3://b/k")->{arn})->{uri}, "s3://b/k", "arn_to_s3_uri: round-trips s3_uri_to_arn"
assert_dies fn { AWS::arn_to_s3_uri("arn:aws:s3:us-east-1:123:bucket/k") }, "arn_to_s3_uri: rejects region/account-bearing ARN"

assert_ok AWS::valid_bucket_name("my-logs.2025")->{valid}, "valid_bucket_name: legal"
val $ip = AWS::valid_bucket_name("192.168.0.1")
assert_eq $ip->{valid}, 0, "valid_bucket_name: rejects IP form"
assert_match qr/IP address/, $ip->{reason}, "valid_bucket_name: reason names the rule"

# partition_for_region: region → ARN partition.
assert_eq AWS::partition_for_region("us-east-1")->{partition},    "aws",        "partition_for_region: standard region"
assert_eq AWS::partition_for_region("cn-north-1")->{partition},   "aws-cn",     "partition_for_region: China"
assert_eq AWS::partition_for_region("us-gov-west-1")->{partition},"aws-us-gov", "partition_for_region: GovCloud"
assert_eq AWS::partition_for_region("us-iso-east-1")->{partition},"aws-iso",    "partition_for_region: ISO (Secret)"
assert_eq AWS::partition_for_region("us-isob-east-1")->{partition},"aws-iso-b", "partition_for_region: ISO-B (Top Secret) beats us-iso- prefix"

# dns_suffix_for_partition: partition → endpoint DNS suffix (botocore).
assert_eq AWS::dns_suffix_for_partition("aws")->{dns_suffix},        "amazonaws.com",     "dns_suffix: standard"
assert_eq AWS::dns_suffix_for_partition("aws-cn")->{dns_suffix},     "amazonaws.com.cn",  "dns_suffix: China"
assert_eq AWS::dns_suffix_for_partition("aws-us-gov")->{dns_suffix}, "amazonaws.com",     "dns_suffix: GovCloud"
assert_eq AWS::dns_suffix_for_partition("aws-iso")->{dns_suffix},    "c2s.ic.gov",        "dns_suffix: ISO"
assert_eq AWS::dns_suffix_for_partition("aws-iso-b")->{dns_suffix},  "sc2s.sgov.gov",     "dns_suffix: ISO-B"
# pairs with partition_for_region.
assert_eq AWS::dns_suffix_for_partition(AWS::partition_for_region("cn-north-1")->{partition})->{dns_suffix}, "amazonaws.com.cn", "dns_suffix: region → partition → suffix"
assert_dies fn { AWS::dns_suffix_for_partition("aws-mars") }, "dns_suffix: rejects an unknown partition"

# service_endpoint: <service>.<region>.<dns_suffix> across partitions.
assert_eq AWS::service_endpoint("s3", "us-east-1")->{endpoint}, "s3.us-east-1.amazonaws.com", "service_endpoint: commercial"
assert_eq AWS::service_endpoint("s3", "us-east-1")->{url}, "https://s3.us-east-1.amazonaws.com", "service_endpoint: https url"
assert_eq AWS::service_endpoint("dynamodb", "cn-north-1")->{endpoint}, "dynamodb.cn-north-1.amazonaws.com.cn", "service_endpoint: China suffix"
assert_eq AWS::service_endpoint("ec2", "us-gov-west-1")->{endpoint}, "ec2.us-gov-west-1.amazonaws.com", "service_endpoint: GovCloud"
assert_eq AWS::service_endpoint("s3", "us-iso-east-1")->{partition}, "aws-iso", "service_endpoint: ISO partition resolved"
assert_dies fn { AWS::service_endpoint("s3", "") }, "service_endpoint: requires a region"

test_run
