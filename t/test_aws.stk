# t/test_aws.stk — connectivity tests against a live AWS account.
#
# Requires the cdylib to be loaded. Install once with `s pkg install -g .`
# from the package root so stryke's FFI bridge dlopens
# lib/libstryke_aws.{dylib,so} on `use AWS`.
#
# Set $STRYKE_AWS_TEST_BUCKET / $STRYKE_AWS_TEST_TABLE / $STRYKE_AWS_TEST_QUEUE
# to opt into the per-service round-trips that need a writable resource.

use AWS

val $have_cdylib = eval { AWS::version(); 1 }
unless ($have_cdylib) {
    p "1..0 # SKIP cdylib not loaded — run `s pkg install -g .` first"
    exit 0
}

val $have_helper = eval { AWS::helper_path(); 1 }
unless ($have_helper) {
    p "1..0 # SKIP helper not built — run `cargo build --release` first"
    exit 0
}

val $have_creds = eval { AWS::STS::caller_identity(); 1 }
unless ($have_creds) {
    p "1..0 # SKIP no AWS credentials reachable (STS get-caller-identity failed)"
    exit 0
}

val $bucket = $ENV{STRYKE_AWS_TEST_BUCKET}
val $table  = $ENV{STRYKE_AWS_TEST_TABLE}
val $queue  = $ENV{STRYKE_AWS_TEST_QUEUE}

var $plan = 2
$plan += 5 if defined $bucket
$plan += 4 if defined $table
$plan += 3 if defined $queue
p "1..$plan"
var $i = 0

# 1. caller identity
var $id
eval { $id = AWS::STS::caller_identity() }
$i++
p $@ ? "not ok $i - caller_identity: $@" :
       (defined $id->{account} && defined $id->{arn}
            ? "ok $i - caller_identity (account=$id->{account})"
            : "not ok $i - caller_identity missing fields")

# 2. plumbing ping
$i++
p (AWS::ping() ? "ok $i - ping (creds present)" : "not ok $i - ping returned false")

# ---- S3 round-trip (only if $STRYKE_AWS_TEST_BUCKET set) ----
if (defined $bucket) {
    val $key = "stryke-aws-test/$$/" . time() . ".txt"
    val $uri = "s3://$bucket/$key"
    var $body = "hello-from-stryke-aws-$$"

    var $r
    eval { $r = AWS::S3::put($uri, data => $body) }
    $i++
    p $@ ? "not ok $i - s3 put: $@" :
           ($r->{key} eq $key ? "ok $i - s3 put" : "not ok $i - s3 put bad shape")

    var $got
    eval { $got = AWS::S3::get($uri) }
    $i++
    p $@ ? "not ok $i - s3 get: $@" :
           ($got eq $body ? "ok $i - s3 get round-trip" :
            "not ok $i - s3 get returned " . len($got) . " bytes, want " . len($body))

    var $head
    eval { $head = AWS::S3::head($uri) }
    $i++
    p $@ ? "not ok $i - s3 head: $@" :
           ($head->{size} == len($body) ? "ok $i - s3 head" : "not ok $i - s3 head wrong size")

    var @ls
    eval { @ls = AWS::S3::ls("s3://$bucket/stryke-aws-test/$$/") }
    $i++
    p $@ ? "not ok $i - s3 ls: $@" :
           (len(@ls) >= 1 ? "ok $i - s3 ls (#{len(@ls)} entries)" :
            "not ok $i - s3 ls empty")

    eval { AWS::S3::rm($uri) }
    $i++
    p $@ ? "not ok $i - s3 rm: $@" : "ok $i - s3 rm"
}

# ---- Dynamo round-trip (only if $STRYKE_AWS_TEST_TABLE set) ----
if (defined $table) {
    val $pk = "stryke-aws-test-$$"

    var $r
    eval { $r = AWS::Dynamo::put($table, { id => $pk, val => "alice", n => 42 }) }
    $i++
    p $@ ? "not ok $i - ddb put: $@" :
           ($r->{ok} ? "ok $i - ddb put" : "not ok $i - ddb put wrong shape")

    var $got
    eval { $got = AWS::Dynamo::get($table, { id => $pk }) }
    $i++
    p $@ ? "not ok $i - ddb get: $@" :
           (defined $got && $got->{val} eq "alice" && $got->{n} == 42
                ? "ok $i - ddb get round-trip"
                : "not ok $i - ddb get wrong shape")

    var @q
    eval { @q = AWS::Dynamo::query($table, expr => "id = :id", vals => { ":id" => $pk }) }
    $i++
    p $@ ? "not ok $i - ddb query: $@" :
           (len(@q) == 1 && $q[0]->{val} eq "alice"
                ? "ok $i - ddb query"
                : "not ok $i - ddb query wrong shape")

    eval { AWS::Dynamo::delete($table, { id => $pk }) }
    $i++
    p $@ ? "not ok $i - ddb delete: $@" : "ok $i - ddb delete"
}

# ---- SQS round-trip (only if $STRYKE_AWS_TEST_QUEUE set) ----
if (defined $queue) {
    val $body = "msg-from-stryke-aws-$$-" . time()

    var $sent
    eval { $sent = AWS::SQS::send($queue, $body) }
    $i++
    p $@ ? "not ok $i - sqs send: $@" :
           (defined $sent->{message_id} ? "ok $i - sqs send" :
            "not ok $i - sqs send wrong shape")

    var @msgs
    eval { @msgs = AWS::SQS::receive($queue, max => 1, wait => 5) }
    $i++
    if ($@) {
        p "not ok $i - sqs receive: $@"
    } else {
        var $found = 0
        var $rh
        for val $m (@msgs) {
            if ($m->{body} eq $body) {
                $found = 1
                $rh = $m->{receipt_handle}
                last
            }
        }
        p ($found ? "ok $i - sqs receive (found our body)"
                  : "not ok $i - sqs receive missing our body")
        # 3rd test: delete the message we just received
        $i++
        if (defined $rh) {
            eval { AWS::SQS::delete($queue, $rh) }
            p $@ ? "not ok $i - sqs delete: $@" : "ok $i - sqs delete"
        } else {
            p "not ok $i - sqs delete skipped (no receipt)"
        }
    }
}
