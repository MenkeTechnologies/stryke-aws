## lib/SQS.stk — `use AWS::SQS`
##
## Wraps `AWS::sqs_*` from the v0.2.0 cdylib.

package AWS::SQS

use AWS

## Send a single message. Returns the cdylib's send response hash
## (includes `message_id`).
fn AWS::SQS::send ($queue, $body, %opts) {
    if (defined $opts{delay_seconds} || defined $opts{dedup_id} || defined $opts{group_id}) {
        die "AWS::SQS::send: delay_seconds / dedup_id / group_id deferred in v0.2.0 cdylib — extend aws__sqs_send_message"
    }
    AWS::sqs_send_message($queue, $body, %opts)
}

## Long-poll. Returns 0..N message hashrefs ({ message_id, receipt_handle, body }).
## `max` (default 1) and `wait` (deferred — uses default polling) supported.
fn AWS::SQS::receive ($queue, %opts) {
    if (defined $opts{wait} || defined $opts{visibility}) {
        die "AWS::SQS::receive: wait / visibility deferred in v0.2.0 cdylib — extend aws__sqs_receive_message"
    }
    AWS::sqs_receive_message($queue, %opts)
}

## Delete one received message by its receipt handle.
fn AWS::SQS::delete ($queue, $receipt, %opts) {
    AWS::sqs_delete_message($queue, $receipt, %opts) ? { deleted => 1 } : { deleted => 0 }
}

## Purge a queue — delete all its messages. Returns 1 on success.
fn AWS::SQS::purge ($queue, %opts) {
    AWS::sqs_purge_queue($queue, %opts)
}

## All queue attributes as a hashref (ApproximateNumberOfMessages, etc.).
fn AWS::SQS::attrs ($queue, %opts) {
    AWS::sqs_get_queue_attributes($queue, %opts)
}

## List queue URLs (no prefix filter in v0.2.0 — extend cdylib if needed).
fn AWS::SQS::list (%opts) {
    if (defined $opts{prefix}) {
        die "AWS::SQS::list: prefix filter deferred in v0.2.0 cdylib — call AWS::sqs_list_queues() then grep client-side"
    }
    AWS::sqs_list_queues(%opts)
}

## SetQueueAttributes from an $attributes { name => value } hashref. Returns 1.
fn AWS::SQS::set_attrs ($queue, $attributes, %opts) {
    AWS::sqs_set_queue_attributes($queue, $attributes, %opts)
}

## ChangeMessageVisibility for a received message. Returns 1 on success.
fn AWS::SQS::change_visibility ($queue, $receipt, $visibility_timeout, %opts) {
    AWS::sqs_change_message_visibility($queue, $receipt, $visibility_timeout, %opts)
}

## Convenience: long-poll a queue and pump every message through a
## callback, deleting on success. Returns the count handled.
fn AWS::SQS::pump ($queue, %opts) {
    die "AWS::SQS::pump: callback => sub { … } is required" unless defined $opts{callback}
    val $cb = $opts{callback}
    val $iters = $opts{iterations} // 1
    var $n = 0
    for (1 .. $iters) {
        val @msgs = AWS::SQS::receive($queue, %opts)
        last unless @msgs
        for val $m (@msgs) {
            $cb->($m)
            AWS::SQS::delete($queue, $m->{receipt_handle}, %opts)
            $n++
        }
    }
    $n
}

