## lib/STS.stk — `use AWS::STS`
##
## Wraps `AWS::sts_caller_identity` from the v0.2.0 cdylib.

package AWS::STS

use AWS

## Returns { account, arn, user_id }.
fn AWS::STS::caller_identity (%opts) {
    AWS::sts_caller_identity(%opts)
}

## Assume an IAM role; returns temporary credentials. opts: session_name.
fn AWS::STS::assume_role ($role_arn, %opts) {
    AWS::sts_assume_role($role_arn, %opts)
}

