# lib/STS.stk — `use AWS::STS`

package AWS::STS

use AWS

# Returns { account, arn, user_id }.
fn AWS::STS::caller_identity (%opts) {
    my @argv = AWS::_conn_argv(\%opts)
    push @argv, "sts", "caller-identity"
    AWS::_run_json(\@argv)
}

# Returns { access_key_id, secret_access_key, session_token, expiration,
#           assumed_role_arn }.
fn AWS::STS::assume_role ($role_arn, %opts) {
    die "AWS::STS::assume_role: session => '…' is required" unless defined $opts{session}
    my @argv = AWS::_conn_argv(\%opts)
    push @argv, "sts", "assume-role", AWS::_shq($role_arn), "--session", AWS::_shq($opts{session})
    push @argv, "--duration", AWS::_shq($opts{duration}) if defined $opts{duration}
    push @argv, "--external-id", AWS::_shq($opts{external_id}) if defined $opts{external_id}
    AWS::_run_json(\@argv)
}

1
