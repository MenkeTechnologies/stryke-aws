## lib/Secrets.stk — `use AWS::Secrets` (Secrets Manager)
##
## Wraps `AWS::secrets_*` from the cdylib.

package AWS::Secrets

use AWS

## Get a secret's string value by id (name or ARN).
fn AWS::Secrets::get ($secret_id, %opts) {
    AWS::secrets_get_value($secret_id, %opts)
}

## Create a new secret named $name holding $secret_string. Returns { arn, name }.
fn AWS::Secrets::create ($name, $secret_string, %opts) {
    AWS::secrets_create($name, $secret_string, %opts)
}

## Store a new version of $secret_id's value. Returns the new version_id.
fn AWS::Secrets::put ($secret_id, $secret_string, %opts) {
    AWS::secrets_put_value($secret_id, $secret_string, %opts)
}

## List secrets as { name, arn } hashrefs.
fn AWS::Secrets::list (%opts) {
    AWS::secrets_list(%opts)
}
