## lib/Dynamo.stk — `use AWS::Dynamo`
##
## Wraps `AWS::ddb_*` from the v0.2.0 cdylib. Plain-JSON in, plain-JSON
## out. The cdylib handles AttributeValue envelopes internally — stryke
## users pass `{ id => 42 }`, not `{ id => { N => "42" } }`.

package AWS::Dynamo

use AWS

## Returns the item hashref, or undef when no item matches.
fn AWS::Dynamo::get ($table, $key, %opts) {
    AWS::ddb_get_item($table, $key, %opts)
}

## Upserts one item. Returns 1 on success.
fn AWS::Dynamo::put ($table, $item, %opts) {
    AWS::ddb_put_item($table, $item, %opts)
}

## Delete one item by $key hashref. Returns 1 on success.
fn AWS::Dynamo::delete ($table, $key, %opts) {
    AWS::ddb_delete_item($table, $key, %opts)
}

## Query $table. opts: key_condition (required), values, names, filter, index,
## limit. Returns a list of item hashrefs.
fn AWS::Dynamo::query ($table, %opts) {
    AWS::ddb_query($table, %opts)
}

## Scan $table. opts: filter, values, limit. Returns a list of item hashrefs.
fn AWS::Dynamo::scan ($table, %opts) {
    AWS::ddb_scan($table, %opts)
}

## Deferred in v0.2.0 cdylib — batch_write needs a BatchWriteItem export.
fn AWS::Dynamo::batch_write ($table, $rows, %opts) {
    die "AWS::Dynamo::batch_write: deferred in v0.2.0 cdylib — add aws__ddb_batch_write to the export list"
}

## Deferred in v0.2.0 cdylib — paginated streaming scan needs a callback shape.
fn AWS::Dynamo::scan_stream ($table, %opts) {
    die "AWS::Dynamo::scan_stream: streaming scan deferred in v0.2.0 cdylib"
}

## DescribeTable $table — status, item_count, key_schema, arn.
fn AWS::Dynamo::describe ($table, %opts) {
    AWS::ddb_describe_table($table, %opts)
}

## Returns a list of table names.
fn AWS::Dynamo::tables (%opts) {
    AWS::ddb_list_tables(%opts)
}

