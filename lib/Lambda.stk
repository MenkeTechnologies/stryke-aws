## lib/Lambda.stk — `use AWS::Lambda`
##
## Wraps `AWS::lambda_*` from the v0.2.0 cdylib.

package AWS::Lambda

use AWS

## Sync invoke. Returns the full response hash:
##   { function, status_code, result }
## `$payload` is encoded as JSON and sent to the function.
## `invocation_type => "event"` (fire-and-forget) is deferred in v0.2.0.
fn AWS::Lambda::invoke ($name, $payload, %opts) {
    if (defined $opts{invocation_type} && $opts{invocation_type} eq "event") {
        die "AWS::Lambda::invoke: invocation_type=event deferred in v0.2.0 cdylib"
    }
    AWS::lambda_invoke($name, $payload, %opts)
}

## Convenience: sync invoke, return just the payload (or undef if the
## function returned a non-success status code).
fn AWS::Lambda::call ($name, $payload, %opts) {
    my $r = AWS::Lambda::invoke($name, $payload, %opts)
    return undef unless defined $r && ($r->{status_code} // 0) == 200
    $r->{result}
}

## List function names.
fn AWS::Lambda::list (%opts) {
    AWS::lambda_list_functions(%opts)
}

