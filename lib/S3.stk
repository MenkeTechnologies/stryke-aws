## lib/S3.stk — `use AWS::S3`
##
## URI-flavored wrappers around `AWS::s3_*` from the v0.2.0 cdylib.
## Object URIs use the standard `s3://bucket/key` form.

package AWS::S3

use AWS

## Internal: parse `s3://bucket/key` → ($bucket, $key). `$key` may be "".
fn AWS::S3::_parse ($uri) {
    die "AWS::S3: expected s3://bucket/key, got `$uri`" unless $uri =~ m{^s3://([^/]+)/?(.*)$}
    ($1, $2)
}

## Returns an array of object hashrefs under the URI prefix.
## Each row: { key, size }.
fn AWS::S3::ls ($uri, %opts) {
    val ($bucket, $prefix) = AWS::S3::_parse($uri)
    AWS::s3_list_objects($bucket, prefix => $prefix, %opts)
}

## Returns the object's body as a byte string. Pass `output => "/path"`
## to write to a file instead and get the path back.
fn AWS::S3::get ($uri, %opts) {
    val ($bucket, $key) = AWS::S3::_parse($uri)
    val $body = AWS::s3_get_object($bucket, $key, %opts)
    if (defined $opts{output}) {
        open val $fh, ">", $opts{output} or die "AWS::S3::get: open $opts{output}: $!"
        print $fh $body
        close $fh
        return $opts{output}
    }
    $body
}

## Upload a scalar string OR a local file. Pass `data => $bytes` or
## `input => "/local/path"`. Returns the put-object response hash.
fn AWS::S3::put ($uri, %opts) {
    val ($bucket, $key) = AWS::S3::_parse($uri)
    var $body
    if (defined $opts{data}) {
        $body = $opts{data}
    } elsif (defined $opts{input}) {
        open val $fh, "<", $opts{input} or die "AWS::S3::put: open $opts{input}: $!"
        local $/
        $body = <$fh>
        close $fh
    } else {
        die "AWS::S3::put: pass data => \$bytes or input => \"path\""
    }
    AWS::s3_put_object($bucket, $key, $body, %opts)
}

## HEAD an object. Deferred in v0.2.0 (cdylib doesn't expose head_object yet).
fn AWS::S3::head ($uri, %opts) {
    die "AWS::S3::head: deferred in v0.2.0 cdylib — use AWS::S3::ls(s3://bucket/prefix) and filter, or add aws__s3_head_object"
}

## Delete an object.
fn AWS::S3::rm ($uri, %opts) {
    val ($bucket, $key) = AWS::S3::_parse($uri)
    AWS::s3_delete_object($bucket, $key, %opts) ? { deleted => 1 } : { deleted => 0 }
}

## Pre-signed URL. Deferred in v0.2.0.
fn AWS::S3::presign ($uri, %opts) {
    die "AWS::S3::presign: deferred in v0.2.0 cdylib — add aws__s3_presign to the cdylib export list"
}

## List buckets — array of bucket name strings.
fn AWS::S3::buckets (%opts) {
    AWS::s3_list_buckets(%opts)
}

