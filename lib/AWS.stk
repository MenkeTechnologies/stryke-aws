## lib/AWS.stk — AWS client for stryke (`use AWS`).
##
## Thin wrapper around the `stryke-aws` cdylib's `aws__*` exports.
## The cdylib is dlopened in-process on first `use AWS` (see stryke's
## `pkg/commands.rs::try_load_ffi_for`) and registers each export as a
## stryke-callable function via `rust_ffi::load_cdylib`.
##
## Replaces the v1 helper-binary model (fork(2) + exec(2) + fresh AWS
## SDK config init per call — including IMDS/SSO/env creds chain). The
## cdylib holds one shared tokio runtime + an `SdkConfig` cache per
## region. Back-to-back calls reuse the same SDK config.
##
## Surface across S3, DynamoDB, SQS, Lambda, STS, SNS, SSM Parameter
## Store, and Secrets Manager. Further ops can be added incrementally.

package AWS

# ── error dispatch ────────────────────────────────────────────────────

## Decode the cdylib's JSON return; die on `{error}` payload.
fn AWS::_decode ($name, $json) {
    val $o = from_json $json
    if (ref $o eq "HASH" && exists $o->{error}) {
        die "AWS::$name: $o->{error}"
    }
    $o
}

## Build the FFI request hash by merging the caller's connection opts.
fn AWS::_req ($extra, $opts) {
    var %r = %$extra
    $r{region} = $opts->{region} if exists $opts->{region} && defined $opts->{region}
    \%r
}

# ── version + caller identity ───────────────────────────────────────

## Return the package version string.
fn AWS::version {
    AWS::_decode("pkg_version", aws__pkg_version("{}"))->{version}
}

## Connectivity probe — returns 1 on success, 0 on failure.
fn AWS::ping (%opts) {
    eval { AWS::sts_caller_identity(%opts); 1 } ? 1 : 0
}

## STS GetCallerIdentity — { account, arn, user_id }.
fn AWS::sts_caller_identity (%opts) {
    AWS::_decode("sts_caller_identity",
        aws__sts_caller_identity(to_json(AWS::_req({}, \%opts))))
}

## AssumeRole $role_arn. opts: session_name (default "stryke-aws"). Returns
## { access_key_id, secret_access_key, session_token, expiration }.
fn AWS::sts_assume_role ($role_arn, %opts) {
    val $r = AWS::_req({ role_arn => $role_arn, session_name => $opts{session_name} }, \%opts)
    AWS::_decode("sts_assume_role", aws__sts_assume_role(to_json($r)))
}

# ── S3 ──────────────────────────────────────────────────────────────

## List S3 bucket names visible to the caller.
fn AWS::s3_list_buckets (%opts) {
    val $o = AWS::_decode("s3_list_buckets",
        aws__s3_list_buckets(to_json(AWS::_req({}, \%opts))))
    @{ $o->{buckets} }
}

## List S3 objects under $bucket with `prefix => "..."`.
fn AWS::s3_list_objects ($bucket, %opts) {
    val $r = AWS::_req({ bucket => $bucket, prefix => $opts{prefix} }, \%opts)
    val $o = AWS::_decode("s3_list_objects", aws__s3_list_objects(to_json($r)))
    @{ $o->{objects} }
}

## Download object body as a scalar (string or `base64:...` for binary).
fn AWS::s3_get_object ($bucket, $key, %opts) {
    val $r = AWS::_req({ bucket => $bucket, key => $key }, \%opts)
    AWS::_decode("s3_get_object", aws__s3_get_object(to_json($r)))->{body}
}

## Upload $body to s3://$bucket/$key. Returns { bucket, key, etag }.
fn AWS::s3_put_object ($bucket, $key, $body, %opts) {
    val $r = AWS::_req({ bucket => $bucket, key => $key, body => $body }, \%opts)
    AWS::_decode("s3_put_object", aws__s3_put_object(to_json($r)))
}

## Delete s3://$bucket/$key. Returns 1 on success.
fn AWS::s3_delete_object ($bucket, $key, %opts) {
    val $r = AWS::_req({ bucket => $bucket, key => $key }, \%opts)
    AWS::_decode("s3_delete_object", aws__s3_delete_object(to_json($r)))->{deleted} ? 1 : 0
}

## HeadObject metadata: { content_length, content_type, etag, last_modified }.
fn AWS::s3_head_object ($bucket, $key, %opts) {
    val $r = AWS::_req({ bucket => $bucket, key => $key }, \%opts)
    AWS::_decode("s3_head_object", aws__s3_head_object(to_json($r)))
}

# ── DynamoDB ────────────────────────────────────────────────────────

## List DynamoDB table names.
fn AWS::ddb_list_tables (%opts) {
    val $o = AWS::_decode("ddb_list_tables",
        aws__ddb_list_tables(to_json(AWS::_req({}, \%opts))))
    @{ $o->{tables} }
}

## PutItem on $table with $item hashref. Returns 1 on success.
fn AWS::ddb_put_item ($table, $item, %opts) {
    die "AWS::ddb_put_item: item must be hashref" unless ref($item) eq "HASH"
    val $r = AWS::_req({ table => $table, item => $item }, \%opts)
    AWS::_decode("ddb_put_item", aws__ddb_put_item(to_json($r)))->{put} ? 1 : 0
}

## GetItem from $table by $key hashref. Returns the item or undef.
fn AWS::ddb_get_item ($table, $key, %opts) {
    die "AWS::ddb_get_item: key must be hashref" unless ref($key) eq "HASH"
    val $r = AWS::_req({ table => $table, key => $key }, \%opts)
    AWS::_decode("ddb_get_item", aws__ddb_get_item(to_json($r)))->{item}
}

## DeleteItem from $table by $key hashref. Returns 1 on success.
fn AWS::ddb_delete_item ($table, $key, %opts) {
    die "AWS::ddb_delete_item: key must be hashref" unless ref($key) eq "HASH"
    val $r = AWS::_req({ table => $table, key => $key }, \%opts)
    AWS::_decode("ddb_delete_item", aws__ddb_delete_item(to_json($r)))->{deleted} ? 1 : 0
}

## Query $table. opts: key_condition (required), values (hashref of
## :placeholder => value), names (hashref of #alias => attr), filter, index,
## limit. Returns a list of item hashrefs.
fn AWS::ddb_query ($table, %opts) {
    val $r = AWS::_req(
        { table => $table, key_condition => $opts{key_condition}, values => $opts{values},
          names => $opts{names}, filter => $opts{filter}, index => $opts{index},
          limit => $opts{limit} }, \%opts)
    val $o = AWS::_decode("ddb_query", aws__ddb_query(to_json($r)))
    @{ $o->{items} }
}

## Scan $table. opts: filter, values, limit. Returns a list of item hashrefs.
fn AWS::ddb_scan ($table, %opts) {
    val $r = AWS::_req(
        { table => $table, filter => $opts{filter}, values => $opts{values},
          limit => $opts{limit} }, \%opts)
    val $o = AWS::_decode("ddb_scan", aws__ddb_scan(to_json($r)))
    @{ $o->{items} }
}

## DescribeTable $table — status, item_count, key_schema, arn.
fn AWS::ddb_describe_table ($table, %opts) {
    AWS::_decode("ddb_describe_table",
        aws__ddb_describe_table(to_json(AWS::_req({ table => $table }, \%opts))))
}

# ── SQS ─────────────────────────────────────────────────────────────

## List SQS queue URLs.
fn AWS::sqs_list_queues (%opts) {
    val $o = AWS::_decode("sqs_list_queues",
        aws__sqs_list_queues(to_json(AWS::_req({}, \%opts))))
    @{ $o->{queues} }
}

## SendMessage; returns the new message_id.
fn AWS::sqs_send_message ($queue_url, $body, %opts) {
    val $r = AWS::_req({ queue_url => $queue_url, body => $body }, \%opts)
    AWS::_decode("sqs_send_message", aws__sqs_send_message(to_json($r)))->{message_id}
}

## ReceiveMessage; returns array of message hashrefs.
fn AWS::sqs_receive_message ($queue_url, %opts) {
    val $r = AWS::_req({ queue_url => $queue_url, max => $opts{max} }, \%opts)
    val $o = AWS::_decode("sqs_receive_message", aws__sqs_receive_message(to_json($r)))
    @{ $o->{messages} }
}

## DeleteMessage by receipt handle. Returns 1 on success.
fn AWS::sqs_delete_message ($queue_url, $receipt_handle, %opts) {
    val $r = AWS::_req({ queue_url => $queue_url, receipt_handle => $receipt_handle }, \%opts)
    AWS::_decode("sqs_delete_message", aws__sqs_delete_message(to_json($r)))->{deleted} ? 1 : 0
}

## PurgeQueue — delete all messages. Returns 1 on success.
fn AWS::sqs_purge_queue ($queue_url, %opts) {
    AWS::_decode("sqs_purge_queue",
        aws__sqs_purge_queue(to_json(AWS::_req({ queue_url => $queue_url }, \%opts))))->{purged} ? 1 : 0
}

## GetQueueAttributes — returns a hashref of all queue attributes.
fn AWS::sqs_get_queue_attributes ($queue_url, %opts) {
    AWS::_decode("sqs_get_queue_attributes",
        aws__sqs_get_queue_attributes(to_json(AWS::_req({ queue_url => $queue_url }, \%opts))))->{attributes}
}

# ── Lambda ──────────────────────────────────────────────────────────

## Sync Invoke; returns { function, status_code, result }.
fn AWS::lambda_invoke ($function, $payload, %opts) {
    val $r = AWS::_req({ function => $function, payload => $payload }, \%opts)
    AWS::_decode("lambda_invoke", aws__lambda_invoke(to_json($r)))
}

## List Lambda function names.
fn AWS::lambda_list_functions (%opts) {
    val $o = AWS::_decode("lambda_list_functions",
        aws__lambda_list_functions(to_json(AWS::_req({}, \%opts))))
    @{ $o->{functions} }
}

# ── S3 copy + batch delete ──────────────────────────────────────────

## Server-side copy s3://$src_bucket/$src_key to s3://$bucket/$key.
fn AWS::s3_copy_object ($src_bucket, $src_key, $bucket, $key, %opts) {
    val $r = AWS::_req(
        { source_bucket => $src_bucket, source_key => $src_key,
          bucket => $bucket, key => $key }, \%opts)
    AWS::_decode("s3_copy_object", aws__s3_copy_object(to_json($r)))
}

## Batch-delete up to 1000 keys from $bucket. Returns the deleted-keys list.
fn AWS::s3_delete_objects ($bucket, $keys, %opts) {
    val $list = ref($keys) eq "ARRAY" ? $keys : [$keys]
    val $r = AWS::_req({ bucket => $bucket, keys => $list }, \%opts)
    @{ AWS::_decode("s3_delete_objects", aws__s3_delete_objects(to_json($r)))->{deleted} }
}

## UpdateItem on $table: set each attr in $updates hashref for the $key item.
fn AWS::ddb_update_item ($table, $key, $updates, %opts) {
    die "AWS::ddb_update_item: key must be hashref" unless ref($key) eq "HASH"
    die "AWS::ddb_update_item: updates must be hashref" unless ref($updates) eq "HASH"
    val $r = AWS::_req({ table => $table, key => $key, updates => $updates }, \%opts)
    AWS::_decode("ddb_update_item", aws__ddb_update_item(to_json($r)))->{updated} ? 1 : 0
}

## BatchGetItem — fetch up to 100 items from $table by $keys (arrayref of key
## hashrefs). Returns the found items as a list of hashrefs.
fn AWS::ddb_batch_get_item ($table, $keys, %opts) {
    die "AWS::ddb_batch_get_item: keys must be an arrayref of hashrefs" unless ref($keys) eq "ARRAY"
    val $r = AWS::_req({ table => $table, keys => $keys }, \%opts)
    @{ AWS::_decode("ddb_batch_get_item", aws__ddb_batch_get_item(to_json($r)))->{items} }
}

## BatchWriteItem — put and/or delete up to 25 items in $table. opts: puts
## (arrayref of item hashrefs), deletes (arrayref of key hashrefs). Returns the
## count of write requests submitted.
fn AWS::ddb_batch_write_item ($table, %opts) {
    val $r = AWS::_req({ table => $table, puts => $opts{puts}, deletes => $opts{deletes} }, \%opts)
    AWS::_decode("ddb_batch_write_item", aws__ddb_batch_write_item(to_json($r)))->{written}
}

# ── SNS ─────────────────────────────────────────────────────────────

## List SNS topic ARNs.
fn AWS::sns_list_topics (%opts) {
    @{ AWS::_decode("sns_list_topics",
        aws__sns_list_topics(to_json(AWS::_req({}, \%opts))))->{topics} }
}

## Publish $message. opts: topic_arn | target_arn | phone_number, subject.
## Returns the message_id.
fn AWS::sns_publish ($message, %opts) {
    val $r = AWS::_req(
        { message => $message, topic_arn => $opts{topic_arn}, target_arn => $opts{target_arn},
          phone_number => $opts{phone_number}, subject => $opts{subject} }, \%opts)
    AWS::_decode("sns_publish", aws__sns_publish(to_json($r)))->{message_id}
}

## Create (idempotent) a standard topic named $name; returns its ARN.
fn AWS::sns_create_topic ($name, %opts) {
    val $r = AWS::_req({ name => $name }, \%opts)
    AWS::_decode("sns_create_topic", aws__sns_create_topic(to_json($r)))->{topic_arn}
}

## Subscribe $endpoint to $topic_arn over $protocol (sqs/lambda/email/https/…).
## Returns the subscription ARN.
fn AWS::sns_subscribe ($topic_arn, $protocol, $endpoint, %opts) {
    val $r = AWS::_req(
        { topic_arn => $topic_arn, protocol => $protocol, endpoint => $endpoint }, \%opts)
    AWS::_decode("sns_subscribe", aws__sns_subscribe(to_json($r)))->{subscription_arn}
}

# ── SSM Parameter Store ─────────────────────────────────────────────

## Get a parameter value. opts: with_decryption (for SecureString).
fn AWS::ssm_get_parameter ($name, %opts) {
    val $r = AWS::_req(
        { name => $name, with_decryption => ($opts{with_decryption} ? \1 : \0) }, \%opts)
    AWS::_decode("ssm_get_parameter", aws__ssm_get_parameter(to_json($r)))->{value}
}

## Put a parameter. opts: type (String|StringList|SecureString), overwrite.
## Returns the new version number.
fn AWS::ssm_put_parameter ($name, $value, %opts) {
    val $r = AWS::_req(
        { name => $name, value => $value, type => ($opts{type} // "String"),
          overwrite => ($opts{overwrite} ? \1 : \0) }, \%opts)
    AWS::_decode("ssm_put_parameter", aws__ssm_put_parameter(to_json($r)))->{version}
}

## List parameters under $path. opts: recursive, with_decryption. Returns a
## list of { name, value } hashrefs.
fn AWS::ssm_get_parameters_by_path ($path, %opts) {
    val $r = AWS::_req(
        { path => $path, recursive => ($opts{recursive} ? \1 : \0),
          with_decryption => ($opts{with_decryption} ? \1 : \0) }, \%opts)
    @{ AWS::_decode("ssm_get_parameters_by_path",
        aws__ssm_get_parameters_by_path(to_json($r)))->{parameters} }
}

## Delete a parameter by name. Returns 1 on success.
fn AWS::ssm_delete_parameter ($name, %opts) {
    val $r = AWS::_req({ name => $name }, \%opts)
    AWS::_decode("ssm_delete_parameter", aws__ssm_delete_parameter(to_json($r)))->{deleted} ? 1 : 0
}

# ── Secrets Manager ─────────────────────────────────────────────────

## Get a secret's string value by id (name or ARN).
fn AWS::secrets_get_value ($secret_id, %opts) {
    val $r = AWS::_req({ secret_id => $secret_id }, \%opts)
    AWS::_decode("secrets_get_value", aws__secrets_get_value(to_json($r)))->{secret_string}
}

## Create a new secret named $name holding $secret_string. Returns { arn, name }.
fn AWS::secrets_create ($name, $secret_string, %opts) {
    val $r = AWS::_req({ name => $name, secret_string => $secret_string }, \%opts)
    AWS::_decode("secrets_create", aws__secrets_create(to_json($r)))
}

## Store a new version of $secret_id's value. Returns the new version_id.
fn AWS::secrets_put_value ($secret_id, $secret_string, %opts) {
    val $r = AWS::_req({ secret_id => $secret_id, secret_string => $secret_string }, \%opts)
    AWS::_decode("secrets_put_value", aws__secrets_put_value(to_json($r)))->{version_id}
}

## List secrets as { name, arn } hashrefs.
fn AWS::secrets_list (%opts) {
    @{ AWS::_decode("secrets_list",
        aws__secrets_list(to_json(AWS::_req({}, \%opts))))->{secrets} }
}

# ── SES (email) ─────────────────────────────────────────────────────

## Send an email via SES v2. $to is an address or arrayref. opts: subject,
## body, html (send body as HTML). Returns the message_id.
fn AWS::ses_send_email ($from, $to, %opts) {
    val $list = ref($to) eq "ARRAY" ? $to : [$to]
    val $r = AWS::_req(
        { from => $from, to => $list, subject => $opts{subject}, body => $opts{body},
          html => ($opts{html} ? \1 : \0) }, \%opts)
    AWS::_decode("ses_send_email", aws__ses_send_email(to_json($r)))->{message_id}
}

# ── CloudWatch ──────────────────────────────────────────────────────

## Publish a single metric data point. opts: unit (StandardUnit name).
## Returns 1 on success.
fn AWS::cloudwatch_put_metric ($namespace, $metric_name, $value, %opts) {
    val $r = AWS::_req(
        { namespace => $namespace, metric_name => $metric_name, value => $value,
          unit => $opts{unit} }, \%opts)
    AWS::_decode("cloudwatch_put_metric", aws__cloudwatch_put_metric(to_json($r)))->{ok} ? 1 : 0
}

## List metrics ({ namespace, metric_name, dimensions }). opts: namespace,
## metric_name (filters).
fn AWS::cloudwatch_list_metrics (%opts) {
    val $r = AWS::_req({ namespace => $opts{namespace}, metric_name => $opts{metric_name} }, \%opts)
    @{ AWS::_decode("cloudwatch_list_metrics", aws__cloudwatch_list_metrics(to_json($r)))->{metrics} }
}

# ── pure helpers (no AWS) ─────────────────────────────────────────────

## Parse an ARN into a hashref { partition, service, region, account_id,
## resource, resource_type, resource_id }. Everything after the 5th colon is
## the resource, split on the first / or :.
fn AWS::parse_arn ($arn) {
    AWS::_decode("parse_arn", aws__parse_arn(to_json({ arn => $arn })))
}

## Build an ARN from parts. opts: partition (default aws), service, region,
## account_id, resource (service + resource required). Inverse of parse_arn.
fn AWS::build_arn (%opts) {
    val %req = (
        partition => $opts{partition},
        service => $opts{service},
        region => $opts{region},
        account_id => $opts{account_id},
        resource => $opts{resource},
    )
    AWS::_decode("build_arn", aws__build_arn(to_json(\%req)))->{arn}
}

## Parse an "s3://bucket/key" URI into a hashref { bucket, key } (key undef
## when only a bucket is given).
fn AWS::parse_s3_uri ($uri) {
    AWS::_decode("parse_s3_uri", aws__parse_s3_uri(to_json({ uri => $uri })))
}

## Build an "s3://bucket/key" URI from parts. $key is optional; a bare bucket
## yields "s3://bucket". Leading slashes on $key are trimmed. Inverse of
## parse_s3_uri.
fn AWS::build_s3_uri ($bucket, $key = undef) {
    AWS::_decode("build_s3_uri",
        aws__build_s3_uri(to_json({ bucket => $bucket, key => $key })))->{uri}
}

## Convert an "s3://bucket/key" URI to its S3 ARN "arn:PARTITION:s3:::bucket/key"
## (region/account are empty for S3). $partition defaults to "aws". Returns a
## hashref { arn, bucket, key }.
fn AWS::s3_uri_to_arn ($uri, $partition = undef) {
    AWS::_decode("s3_uri_to_arn",
        aws__s3_uri_to_arn(to_json({ uri => $uri, partition => $partition })))
}

## Convert an S3 ARN "arn:PARTITION:s3:::bucket/key" back to its "s3://bucket/key"
## URI (region/account must be empty). Inverse of s3_uri_to_arn. Returns a
## hashref { uri, bucket, key }.
fn AWS::arn_to_s3_uri ($arn) {
    AWS::_decode("arn_to_s3_uri", aws__arn_to_s3_uri(to_json({ arn => $arn })))
}

## Validate an S3 bucket name against AWS's rules. Returns { name, valid,
## reason } (reason undef when valid).
fn AWS::valid_bucket_name ($name) {
    AWS::_decode("valid_bucket_name", aws__valid_bucket_name(to_json({ name => $name })))
}

## Validate an S3 object $key — non-empty and at most 1024 bytes (UTF-8); any
## character (including "/") is allowed. The object-key companion of
## valid_bucket_name. Returns { key, valid, reason, bytes } (reason undef when
## valid; bytes is the UTF-8 length).
fn AWS::valid_s3_key ($key) {
    AWS::_decode("valid_s3_key", aws__valid_s3_key(to_json({ key => $key })))
}

## Validate an Amazon SQS queue $name per CreateQueue: up to 80 chars of
## alphanumeric, hyphens and underscores (case-sensitive). A FIFO queue name ends
## with the ".fifo" suffix (which counts toward the 80-char limit); a "." is
## allowed only in that suffix. Returns a hashref { name, valid, reason, fifo }
## (reason undef when valid; fifo true when the name carries the .fifo suffix).
fn AWS::valid_sqs_queue_name ($name) {
    AWS::_decode("valid_sqs_queue_name", aws__valid_sqs_queue_name(to_json({ name => $name })))
}

## Validate an AWS account ID — exactly 12 decimal digits (leading zeros allowed,
## e.g. "012345678901"). parse_arn surfaces the account field but never checks it;
## this is the standalone predicate. Returns { account_id, valid, reason } (reason
## undef when valid).
fn AWS::valid_account_id ($account_id) {
    AWS::_decode("valid_account_id", aws__valid_account_id(to_json({ account_id => $account_id })))
}

## Validate an ARN's structure as a non-throwing predicate — the { valid, reason }
## companion of parse_arn (which throws and returns the components). Checks the 6
## colon-delimited fields, the "arn" prefix, and a non-empty partition/service/
## resource (region and account may be empty). Returns { arn, valid, reason }
## (reason undef when valid).
fn AWS::valid_arn ($arn) {
    AWS::_decode("valid_arn", aws__valid_arn(to_json({ arn => $arn })))
}

## Resolve the ARN partition for an AWS region: cn-* → aws-cn, us-gov-* →
## aws-us-gov, us-isob-* → aws-iso-b, us-iso-* → aws-iso, else aws. Returns a
## hashref { region, partition }. Feed the partition into build_arn.
fn AWS::partition_for_region ($region) {
    AWS::_decode("partition_for_region", aws__partition_for_region(to_json({ region => $region })))
}

## Validate an AWS region name against botocore partitions.json regionRegex. The
## partition is resolved from the prefix, then the name is checked against that
## partition's documented shape (standard (us|eu|ap|sa|ca|me|af|il|mx)-<area>-<n>,
## cn-/us-gov-/us-iso-/us-isob- variants). Unlike partition_for_region, which
## classifies any string, this rejects malformed names. Returns a hashref
## { region, valid, partition, reason } (reason undef when valid).
fn AWS::valid_region ($region) {
    AWS::_decode("valid_region", aws__valid_region(to_json({ region => $region })))
}

## The DNS suffix for an AWS partition (from botocore partitions.json): aws →
## amazonaws.com, aws-cn → amazonaws.com.cn, aws-us-gov → amazonaws.com, aws-iso
## → c2s.ic.gov, aws-iso-b → sc2s.sgov.gov. Returns a hashref { partition,
## dns_suffix }. Pairs with partition_for_region to build endpoint hostnames.
fn AWS::dns_suffix_for_partition ($partition) {
    AWS::_decode("dns_suffix_for_partition", aws__dns_suffix_for_partition(to_json({ partition => $partition })))
}

## Build a regional service endpoint hostname <service>.<region>.<dns_suffix>
## (e.g. s3.us-east-1.amazonaws.com), resolving the region's partition + DNS
## suffix internally so it works across aws/aws-cn/aws-us-gov/iso. Returns a
## hashref { service, region, partition, dns_suffix, endpoint, url }.
fn AWS::service_endpoint ($service, $region) {
    AWS::_decode("service_endpoint", aws__service_endpoint(to_json({ service => $service, region => $region })))
}

## Parse a regional service endpoint back into its parts — inverse of
## service_endpoint. $endpoint may be a bare host (s3.us-east-1.amazonaws.com) or
## a full URL (scheme and path stripped). The suffix is matched and the region's
## partition resolved. Returns a hashref
## { endpoint, service, region, partition, dns_suffix, url }.
fn AWS::parse_service_endpoint ($endpoint) {
    AWS::_decode("parse_service_endpoint", aws__parse_service_endpoint(to_json({ endpoint => $endpoint })))
}

## Build the virtual-hosted-style HTTPS URL for an S3 object:
## https://<bucket>.s3.<region>.<dns_suffix>/<key>. Resolves the region's
## partition + DNS suffix internally (works across aws/aws-cn/gov/iso). $key is
## percent-encoded; omit it for the bucket root. Returns a hashref
## { url, bucket, region, partition, host }.
fn AWS::s3_object_url ($bucket, $region, $key = undef) {
    AWS::_decode("s3_object_url", aws__s3_object_url(to_json({ bucket => $bucket, region => $region, key => $key })))
}

## Parse an S3 HTTPS URL back into its parts — inverse of s3_object_url. Handles
## virtual-hosted (bucket.s3.region.suffix/key) and path style
## (s3.region.suffix/bucket/key); region may be absent (legacy global). $key is
## percent-decoded; undef for a bucket-root URL. Returns a hashref
## { url, bucket, key, region, partition, style, host, dns_suffix }.
fn AWS::parse_s3_url ($url) {
    AWS::_decode("parse_s3_url", aws__parse_s3_url(to_json({ url => $url })))
}

## Derive the AWS region from an availability-zone name (us-east-1a →
## us-east-1): the AZ with its trailing zone letter removed. Returns a hashref
## { az, region, zone_letter }; dies if the AZ is malformed.
fn AWS::region_for_az ($az) {
    AWS::_decode("region_for_az", aws__region_for_az(to_json({ az => $az })))
}

